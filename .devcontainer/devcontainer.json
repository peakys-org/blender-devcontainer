{
    "name": "Blender Dev Container",
    "dockerComposeFile": "compose.yaml",
    "service": "devcontainer",
    "overrideCommand": true,
    "shutdownAction": "stopCompose",
    "workspaceFolder": "/workspaces/development/extensions/${localWorkspaceFolderBasename}",
	"features": {
        "ghcr.io/devcontainers/features/git-lfs:1": {},
        "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
        "ghcr.io/devcontainers/features/copilot-cli:1.1.4": {},
        "ghcr.io/devcontainers/features/node:2.1.2": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {},
		"ghcr.io/devcontainers/features/python:1": {},
        "ghcr.io/devcontainers-extra/features/uv:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
				"github.copilot",
                "github.copilot-chat",
                "github.vscode-pull-request-github",
                "github.codespaces",
                "github.vscode-github-actions",
                "github.remotehub",
                "ms-python.python",
                "ms-vscode.cpptools",
				"tamasfe.even-better-toml",
                "anthropic.claude-code",
                "openai.chatgpt",
                "yzhang.markdown-all-in-one",
                "davidanson.vscode-markdownlint"
            ]
        }
    },
    "forwardPorts": ["novnc:3000"],
    "portsAttributes": {
        "novnc:3000": {
            "label": "noVNC",
            "onAutoForward": "openBrowser"
        }
    },
    "initializeCommand": "mkdir -p extensions/${localWorkspaceFolderBasename}",
    "onCreateCommand": "python3 -m pip install --break-system-packages --upgrade pip fake-bpy-module",
    "postAttachCommand": "[ -n \"$CODESPACE_NAME\" ] && gh codespace ports visibility 5901:public -c $CODESPACE_NAME || true"
}
